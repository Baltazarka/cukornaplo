Options -Indexes

# Belső fájlok nem érhetők el böngészőből.
<FilesMatch "^(lib|layout|import_health_export|carelink|carelink_poll)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^(Dockerfile|docker-compose\.yml|\.env.*|README\.md|\.dockerignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(data|docker)(/|$) - [F,L]
</IfModule>
